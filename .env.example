# Copy to .env locally. Never commit real secrets.
POSTGRES_DB=personal_os
POSTGRES_USER=personal_os
POSTGRES_PASSWORD=change_me_locally
DATABASE_URL=postgresql+psycopg://personal_os:change_me_locally@db:5432/personal_os
APP_ENV=development
APP_NAME=Personal OS API
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
COOKIE_SECURE=false
BOOTSTRAP_INVITATION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback
TOKEN_ENCRYPTION_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Set this to a random secret when configuring Telegram setWebhook.
TELEGRAM_WEBHOOK_SECRET=

# GitHub OAuth app (read-only public repository activity)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/integrations/github/callback
